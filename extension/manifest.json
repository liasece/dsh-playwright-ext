{
   "action": {
      "default_icon": {
         "16": "icons/icon-16.png",
         "32": "icons/icon-32.png",
         "48": "icons/icon-48.png",
         "128": "icons/icon-128.png"
      },
      "default_title": "DSH Playwright Extension"
   },
   "background": {
      "service_worker": "lib/background.mjs",
      "type": "module"
   },
   "description": "DSH fork of the Playwright Extension: keeps the user active tab and window focus untouched while an AI agent works in a background tab group.",
   "host_permissions": [
      "<all_urls>"
   ],
   "icons": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
   },
   "key": "",
   "manifest_version": 3,
   "name": "DSH Playwright Extension",
   "permissions": [
      "debugger",
      "activeTab",
      "tabs",
      "tabGroups",
      "notifications"
   ],
   "update_url": "https://clients2.google.com/service/update2/crx",
   "version": "0.4.0.8",
   "content_scripts": [
      {
         "matches": [
            "<all_urls>"
         ],
         "js": [
            "content/overlay.js"
         ],
         "run_at": "document_idle",
         "all_frames": false
      }
   ]
}
